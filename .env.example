# Azure DevOps Task Dashboard Environment Configuration

# Backend Proxy Server Port
PORT=3001

# Production Backend Proxy URL (Leave blank in local development to use local Vite middleware proxy)
VITE_API_BASE_URL=https://nefuza-task-board.onrender.com

# Optional default organization / project for pre-filling setup
VITE_AZURE_DEFAULT_ORG=
VITE_AZURE_DEFAULT_PROJECT=

